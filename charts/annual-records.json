{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 260,
  "data": {
    "url": "data/qld_hospital/qld_koala_hospital_annual.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 1997 && datum.year < 2025"
    }
  ],
  "mark": {
    "type": "area",
    "line": {
      "color": "#326b50",
      "strokeWidth": 2
    },
    "color": "#b9cfbd",
    "opacity": 0.75
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": -45,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "record_count",
      "type": "quantitative",
      "title": "Records",
      "axis": {
        "format": ",d"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "record_count",
        "type": "quantitative",
        "format": ",",
        "title": "Records"
      }
    ]
  }
}
