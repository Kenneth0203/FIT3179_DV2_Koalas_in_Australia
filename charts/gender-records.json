{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  },
  "data": {
    "url": "data/qld_hospital/qld_koala_hospital_gender.csv",
    "format": {
      "type": "csv",
      "parse": {
        "record_count": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "record_count",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.record_count / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.adult_gender + '\\n' + format(datum.share, '.1%')",
      "as": "direct_label"
    }
  ],
  "encoding": {
    "theta": {
      "field": "record_count",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "adult_gender",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Male",
          "Female",
          "Not recorded",
          "Unknown"
        ],
        "range": [
          "#326b50",
          "#d08a2e",
          "#3c86a8",
          "#7a5aa6"
        ]
      }
    },
    "order": {
      "field": "adult_gender",
      "sort": [
        "Male",
        "Female",
        "Not recorded",
        "Unknown"
      ]
    },
    "tooltip": [
      {
        "field": "adult_gender",
        "title": "Recorded sex"
      },
      {
        "field": "record_count",
        "type": "quantitative",
        "format": ",",
        "title": "Reports"
      },
      {
        "field": "share",
        "type": "quantitative",
        "format": ".1%",
        "title": "Share of all reports"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "outerRadius": 145,
        "stroke": "#fffefa",
        "strokeWidth": 3,
        "cornerRadius": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 96,
        "fontSize": 13,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "lineHeight": 18,
        "fill": "#fffefa",
        "stroke": "#243e31",
        "strokeWidth": 1.2,
        "strokeOpacity": 0.7
      },
      "encoding": {
        "text": {
          "field": "direct_label"
        }
      }
    }
  ]
}
