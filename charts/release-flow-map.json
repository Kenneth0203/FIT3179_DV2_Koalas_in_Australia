{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      148,
      -27
    ],
    "scale": 1200
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eadf",
        "stroke": "#aab6a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_release_flows.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.record_count >= 3"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#dc9a50",
        "opacity": 0.38
      },
      "encoding": {
        "longitude": {
          "field": "rescue_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "rescue_latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "release_longitude"
        },
        "latitude2": {
          "field": "release_latitude"
        },
        "strokeWidth": {
          "field": "record_count",
          "type": "quantitative",
          "scale": {
            "range": [
              0.4,
              5
            ]
          },
          "legend": {
            "title": "Records"
          }
        },
        "tooltip": [
          {
            "field": "record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Rescue\u2013release records"
          }
        ]
      }
    }
  ]
}
