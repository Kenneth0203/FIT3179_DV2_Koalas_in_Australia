{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      152.3,
      -27
    ],
    "scale": 6500
  },
  "layer": [
    {
      "data": {
        "url": "data/maps/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eadf",
        "stroke": "#aab6a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_release_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "record_count": "number",
            "rescue_latitude": "number",
            "rescue_longitude": "number",
            "release_latitude": "number",
            "release_longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.record_count >= 3 && (datum.rescue_latitude != datum.release_latitude || datum.rescue_longitude != datum.release_longitude)"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "route_rank"
            }
          ],
          "sort": [
            {
              "field": "record_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.route_rank <= 15"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#c66132",
        "opacity": 0.62
      },
      "encoding": {
        "longitude": {
          "field": "rescue_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "rescue_latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "release_longitude"
        },
        "latitude2": {
          "field": "release_latitude"
        },
        "strokeWidth": {
          "field": "record_count",
          "type": "quantitative",
          "scale": {
            "range": [
              1,
              8
            ]
          },
          "legend": {
            "title": "Records"
          }
        },
        "tooltip": [
          {
            "field": "record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Rescue\u2013release records"
          },
          {
            "field": "rescue_latitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Rescue latitude"
          },
          {
            "field": "rescue_longitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Rescue longitude"
          },
          {
            "field": "release_latitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Release latitude"
          },
          {
            "field": "release_longitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Release longitude"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_release_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "record_count": "number",
            "rescue_latitude": "number",
            "rescue_longitude": "number",
            "release_latitude": "number",
            "release_longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.record_count >= 3 && (datum.rescue_latitude != datum.release_latitude || datum.rescue_longitude != datum.release_longitude)"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "route_rank"
            }
          ],
          "sort": [
            {
              "field": "record_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.route_rank <= 15"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#7c2f19",
        "opacity": 0.7,
        "size": 24
      },
      "encoding": {
        "longitude": {
          "field": "release_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "release_latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Records on route"
          },
          {
            "field": "release_latitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Release latitude"
          },
          {
            "field": "release_longitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Release longitude"
          }
        ]
      }
    }
  ]
}
