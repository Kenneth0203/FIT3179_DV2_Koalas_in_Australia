{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      148,
      -27
    ],
    "scale": 1200
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eadf",
        "stroke": "#aab6a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_rescue_grid.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "square",
        "opacity": 0.78
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "value": 55
        },
        "color": {
          "field": "record_count",
          "type": "quantitative",
          "scale": {
            "scheme": "yellowgreenblue",
            "type": "sqrt"
          },
          "legend": {
            "title": "Records per grid cell"
          }
        },
        "tooltip": [
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Latitude"
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Longitude"
          },
          {
            "field": "record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Records"
          }
        ]
      }
    }
  ]
}
