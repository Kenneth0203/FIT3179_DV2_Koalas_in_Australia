{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      152.95,
      -27.35
    ],
    "scale": 9000
  },
  "layer": [
    {
      "data": {
        "url": "data/maps/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eadf",
        "stroke": "#aab6a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_rescue_bins.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "opacity": 0.86,
        "stroke": null
      },
      "encoding": {
        "color": {
          "field": "properties.record_count",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "scheme": "plasma"
          },
          "legend": {
            "title": "Reports per 0.1\u00b0 bin",
            "labelExpr": "format(datum.value, ',')",
            "gradientLength": 260
          }
        },
        "tooltip": [
          {
            "field": "properties.latitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Bin centre latitude"
          },
          {
            "field": "properties.longitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Bin centre longitude"
          },
          {
            "field": "properties.record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Reports in bin"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Sunshine Coast",
            "latitude": -26.65,
            "longitude": 153.07
          },
          {
            "name": "Brisbane",
            "latitude": -27.47,
            "longitude": 153.03
          },
          {
            "name": "Gold Coast",
            "latitude": -28.02,
            "longitude": 153.4
          },
          {
            "name": "Toowoomba",
            "latitude": -27.56,
            "longitude": 151.95
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#fffdf8",
        "stroke": "#243e31",
        "strokeWidth": 1,
        "strokeOpacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    }
  ]
}
