{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      152.6,
      -27.1
    ],
    "scale": 6500
  },
  "layer": [
    {
      "data": {
        "url": "data/maps/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eadf",
        "stroke": "#aab6a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/qld_hospital/qld_koala_hospital_lga.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.mean_latitude) && datum.koala_lga != 'Not recorded'"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "council_rank"
            }
          ],
          "sort": [
            {
              "field": "record_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.council_rank <= 12"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#1769aa",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "mean_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "mean_latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "record_count",
          "type": "quantitative",
          "scale": {
            "range": [
              20,
              1800
            ]
          },
          "legend": {
            "title": "Hospital reports"
          }
        },
        "tooltip": [
          {
            "field": "koala_lga",
            "title": "Council area"
          },
          {
            "field": "record_count",
            "type": "quantitative",
            "format": ",",
            "title": "Hospital reports"
          },
          {
            "field": "mean_latitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Latitude"
          },
          {
            "field": "mean_longitude",
            "type": "quantitative",
            "format": ".2f",
            "title": "Longitude"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"name": "Sunshine Coast", "latitude": -26.65, "longitude": 153.07},
          {"name": "Brisbane", "latitude": -27.47, "longitude": 153.03},
          {"name": "Gold Coast", "latitude": -28.02, "longitude": 153.4},
          {"name": "Toowoomba", "latitude": -27.56, "longitude": 151.95}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#243e31"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "name"}
      }
    }
  ]
}
