          "field": "mean_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "mean_latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "record_count",
          "type": "quantitative",
          "scale": {
            "range": [
              120,
              900
            ]
          },
          "legend": {
            "title": "Hospital reports"
          }
