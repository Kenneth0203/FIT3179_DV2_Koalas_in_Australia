        "url": "data/qld_hospital/qld_koala_hospital_lga.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.mean_latitude) && datum.koala_lga != 'Not recorded'"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "council_rank"
            }
          ],
          "sort": [
            {
              "field": "record_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.council_rank <= 12"
        }
