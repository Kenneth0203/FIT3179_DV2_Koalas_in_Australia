{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator",
    "center": [
      134.5,
      -27.5
    ],
    "scale": 710
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "legend": {
      "orient": "bottom",
      "title": null,
      "labelColor": "#526158",
      "labelFontSize": 12,
      "symbolStrokeColor": "#fffefa",
      "symbolStrokeWidth": 1
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/maps/australian-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/koala_epbc_status_by_state.csv"
            },
            "key": "state_name",
            "fields": [
              "state_code",
              "koala_range",
              "epbc_status",
              "status_group",
              "listing_effective",
              "estimate_group",
              "estimate_year",
              "estimate_lower",
              "estimate_upper",
              "estimate_label",
              "previous_year",
              "previous_lower",
              "previous_upper",
              "previous_label",
              "note"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffefa",
        "strokeWidth": 1.8
      },
      "encoding": {
        "color": {
          "field": "status_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Nationally endangered",
              "Other koala range",
              "Outside published koala range"
            ],
            "range": [
              "#d55e42",
              "#6f9f75",
              "#dfe4dc"
            ]
          },
          "legend": {
            "title": "Status and model coverage",
            "direction": "horizontal",
            "columns": 3
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State or territory"
          },
          {
            "field": "epbc_status",
            "title": "National legal status"
          },
          {
            "field": "listing_effective",
            "title": "Listing effective"
          },
          {
            "field": "estimate_group",
            "title": "NKMP estimate group"
          },
          {
            "field": "estimate_label",
            "title": "2025 published range"
          },
          {
            "field": "previous_label",
            "title": "2024 published range"
          },
          {
            "field": "note",
            "title": "How to interpret"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state_code": "WA",
