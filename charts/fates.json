{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 300,
  "data": {
    "url": "data/qld_hospital/qld_koala_hospital_fates.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "arc",
    "innerRadius": 70,
    "stroke": "#fffefa",
    "strokeWidth": 2
  },
  "encoding": {
    "theta": {
      "field": "record_count",
      "type": "quantitative"
    },
    "color": {
      "field": "adult_fate",
      "type": "nominal",
      "scale": {
        "scheme": "yellowgreenblue"
      },
      "legend": {
        "columns": 2
      }
    },
    "tooltip": [
      {
        "field": "adult_fate",
        "title": "Recorded fate"
      },
      {
        "field": "record_count",
        "type": "quantitative",
        "format": ",",
        "title": "Records"
      },
      {
        "field": "percent_of_all_records",
        "type": "quantitative",
        "format": ".1f",
        "title": "Percent"
      }
    ]
  }
}