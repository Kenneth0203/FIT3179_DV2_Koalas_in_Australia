{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 170,
  "background": "transparent",
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "view": {"stroke": null},
    "font": "Arial",
    "axis": {"labelColor": "#526158", "titleColor": "#34483b", "gridColor": "#e8ece5", "domain": false, "labelFontSize": 12}
  },
  "data": {"url": "src/koala_recovery_projects.csv?v=2", "format": {"type": "csv"}},
  "transform": [
    {
      "aggregate": [
        {"op": "sum", "field": "funding_aud_ex_gst", "as": "total_funding"},
        {"op": "count", "as": "project_count"}
      ],
      "groupby": ["programme_category"]
    },
    {"calculate": "format(datum.total_funding, '$,.0f') + ' across ' + datum.project_count + ' projects'", "as": "summary_label"}
  ],
  "encoding": {
    "y": {
      "field": "programme_category",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {"labelExpr": "datum.label == 'Large habitat restoration' ? 'Habitat restoration' : 'Health projects'", "labelLimit": 180}
    },
    "x": {
      "field": "total_funding",
      "type": "quantitative",
      "title": "Total programme funding (AUD, excluding GST)",
      "scale": {"domain": [0, 32000000]},
      "axis": {"format": "~s", "tickCount": 5}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4, "size": 42},
      "encoding": {
        "color": {
          "field": "programme_category",
          "type": "nominal",
          "scale": {"domain": ["Large habitat restoration", "Health grants"], "range": ["#326b50", "#c8791f"]},
          "legend": null
        },
        "tooltip": [
          {"field": "programme_category", "title": "Programme"},
          {"field": "total_funding", "type": "quantitative", "format": "$,.0f", "title": "Total funding"},
          {"field": "project_count", "type": "quantitative", "title": "Projects"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "fontSize": 12, "fontWeight": "bold", "color": "white"},
      "encoding": {"x": {"datum": 0}, "text": {"field": "summary_label"}}
    }
  ]
}
