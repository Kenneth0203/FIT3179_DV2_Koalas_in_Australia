{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "background": "transparent",
  "height": 560,
  "data": {
    "url": "src/koala_recovery_projects.csv?v=2",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "programme",
      "value": null,
      "bind": {
        "input": "select",
        "options": [
          null,
          "Large habitat restoration",
          "Health grants"
        ],
        "labels": [
          "All programmes",
          "Habitat restoration",
          "Health grants"
        ],
        "name": "Show: "
      }
    }
  ],
  "transform": [
    {
      "filter": "programme == null || datum.programme_category == programme"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "project_title",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 760,
        "labelFontSize": 11,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "funding_aud_ex_gst",
      "type": "quantitative",
      "title": "Funding allocation (AUD, excluding GST)",
      "axis": {
        "format": "~s",
        "tickCount": 5
      }
    },
    "color": {
      "field": "programme_category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Large habitat restoration",
          "Health grants"
        ],
        "range": [
          "#326b50",
          "#dc9a50"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "project_title",
        "title": "Project"
      },
      {
        "field": "delivery_partner",
        "title": "Partner"
      },
      {
        "field": "funding_aud_ex_gst",
        "type": "quantitative",
        "format": "$,.0f",
        "title": "Allocation"
      },
      {
        "field": "programme_category",
        "title": "Programme"
      }
    ]
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
