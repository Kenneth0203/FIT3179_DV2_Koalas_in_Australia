          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "datum.kind === 'project' ? {'Project': datum.project, 'Delivery partner': datum.partner, 'Programme': datum.programme, 'Allocation': format(datum.amount, '$,.0f')} : {'Funding stream': datum.label, 'Summary': datum.sub}"
          }
        }
      }
    },
