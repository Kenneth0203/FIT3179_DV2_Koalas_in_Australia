  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "path": {
            "field": "path"
          },
          "fill": {
            "field": "color"
          },
          "fillOpacity": {
            "field": "opacity"
          },
          "stroke": {
            "field": "color"
          },
          "strokeOpacity": {
            "value": 0.16
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Programme': datum.programme, 'Project': datum.project, 'Delivery partner': datum.partner, 'Allocation': format(datum.amount, '$,.0f')}"
          }
        },
        "update": {
          "fillOpacity": {
            "field": "opacity"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.78
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "x2": {
            "field": "x2"
          },
          "y": {
            "field": "y"
          },
          "y2": {
            "field": "y2"
          },
          "fill": {
            "field": "color"
          },
          "cornerRadius": {
            "value": 2
          },
          "stroke": {
            "value": "#fffdf8"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "datum.kind === 'project' ? {'Project': datum.project, 'Delivery partner': datum.partner, 'Programme': datum.programme, 'Allocation': format(datum.amount, '$,.0f')} : {'Funding stream': datum.label, 'Summary': datum.sub}"
          }
        }
      }
    },
