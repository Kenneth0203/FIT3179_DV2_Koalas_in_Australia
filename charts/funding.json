  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "path": {
            "field": "path"
          },
          "fill": {
            "field": "color"
          },
          "fillOpacity": {
            "field": "opacity"
          },
          "stroke": {
            "field": "color"
          },
          "strokeOpacity": {
            "value": 0.16
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Programme': datum.programme, 'Project': datum.project, 'Delivery partner': datum.partner, 'Allocation': format(datum.amount, '$,.0f')}"
          }
        },
        "update": {
          "fillOpacity": {
            "field": "opacity"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.78
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
