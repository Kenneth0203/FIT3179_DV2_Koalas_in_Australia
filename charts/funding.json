            "value": 0.16
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Programme': datum.programme, 'Project': datum.project, 'Delivery partner': datum.partner, 'Allocation': format(datum.amount, '$,.0f')}"
