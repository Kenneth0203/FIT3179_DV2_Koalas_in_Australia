{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 280,
  "data": {
    "url": "data/qld_hospital/qld_koala_hospital_annual.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 1997 && datum.year < 2025"
    },
    {
      "fold": [
        "vehicle_hit_count",
        "caused_by_dog_count",
        "fall_count"
      ],
      "as": [
        "cause",
        "records"
      ]
    },
    {
      "calculate": "datum.cause == 'vehicle_hit_count' ? 'Vehicle hit' : datum.cause == 'caused_by_dog_count' ? 'Dog attack or interaction' : 'Fall'",
      "as": "cause_label"
    },
    {
      "calculate": "'Incident: ' + datum.cause_label + ' \u2013 ' + format(datum.records, ',')",
      "as": "hover_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": -45,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "records",
      "type": "quantitative",
      "title": "Number of records",
      "axis": {
        "format": ",d"
      },
      "stack": null
    },
    "color": {
      "field": "cause_label",
      "type": "nominal",
      "scale": {
        "range": [
          "#326b50",
          "#dc9a50",
          "#8b6f65"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "cause_label",
        "title": "Recorded incident"
      },
      {
        "field": "records",
        "type": "quantitative",
        "format": ",",
        "title": "Records"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.12,
        "clip": true
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "clip": true
      }
    },
    {
      "transform": [
        {
          "pivot": "cause_label",
          "value": "records",
          "groupby": [
            "year"
          ]
        }
      ],
      "params": [
        {
          "name": "year_hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0
      },
      "encoding": {
        "y": {
          "datum": 0
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Vehicle hit",
            "type": "quantitative",
            "format": ",",
            "title": "Vehicle hit"
          },
          {
            "field": "Dog attack or interaction",
            "type": "quantitative",
            "format": ",",
            "title": "Dog attack or interaction"
          },
          {
            "field": "Fall",
            "type": "quantitative",
            "format": ",",
            "title": "Fall"
          }
        ],
        "y2": {
          "datum": 620
        }
      }
    },
    {
      "transform": [
        {
          "pivot": "cause_label",
          "value": "records",
          "groupby": [
            "year"
          ]
        },
        {
          "filter": {
            "param": "year_hover",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#243e31",
        "strokeWidth": 1.7,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Vehicle hit",
            "type": "quantitative",
            "format": ",",
            "title": "Vehicle hit"
          },
          {
            "field": "Dog attack or interaction",
            "type": "quantitative",
            "format": ",",
            "title": "Dog attack or interaction"
          },
          {
            "field": "Fall",
            "type": "quantitative",
            "format": ",",
            "title": "Fall"
          }
        ]
      }
    }
  ]
}
