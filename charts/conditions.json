{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#526158",
      "titleColor": "#34483b",
      "gridColor": "#e8ece5",
      "domain": false,
      "labelFontSize": 12
    },
    "legend": {
      "orient": "bottom",
      "title": null
    }
  },
  "height": 330,
  "data": {
    "url": "data/qld_hospital/qld_koala_hospital_conditions.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.condition_or_circumstance == 'Sick' ? 'General sickness' : datum.condition_or_circumstance == 'Wasted condition' ? 'Severely underweight' : datum.condition_or_circumstance == 'Cystitis' ? 'Bladder inflammation' : datum.condition_or_circumstance == 'Conjunctivitis' ? 'Eye inflammation' : datum.condition_or_circumstance == 'Recorded dead' ? 'Found dead' : datum.condition_or_circumstance == 'Dog involvement' ? 'Dog attack or interaction' : datum.condition_or_circumstance",
      "as": "plain_label"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4,
    "color": "#326b50"
  },
  "encoding": {
    "y": {
      "field": "plain_label",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "flagged_record_count",
      "type": "quantitative",
      "title": "Number of records",
      "axis": {
        "format": "~s"
      }
    },
    "tooltip": [
      {
        "field": "plain_label",
        "title": "Recorded reason or condition"
      },
      {
        "field": "flagged_record_count",
        "type": "quantitative",
        "format": ",",
        "title": "Records"
      },
      {
        "field": "percent_of_all_records",
        "type": "quantitative",
        "format": ".1f",
        "title": "Percent of records"
      }
    ]
  }
}
